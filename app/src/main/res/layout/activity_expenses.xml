<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExpensesActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expenses_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <ImageButton
            android:id="@+id/expensesMenuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_content_description"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <Button
            android:id="@+id/topExpensesButton"
            android:layout_width="100dp"
            android:layout_height="25dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/light_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/expenses"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/expensesMenuButton"
            app:layout_constraintStart_toEndOf="@id/expensesMenuButton"
            app:layout_constraintTop_toTopOf="@id/expensesMenuButton" />

        <ImageButton
            android:id="@+id/expensesExportButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/export_options_description"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_save"
            app:layout_constraintBottom_toBottomOf="@id/expensesSearchView"
            app:layout_constraintEnd_toStartOf="@id/expensesSearchView"
            app:layout_constraintTop_toTopOf="@id/expensesSearchView"
            app:tint="@color/white" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/expensesSearchView"
            android:layout_width="47dp"
            android:layout_height="33dp"
            android:layout_margin="8dp"
            android:background="@drawable/rounded_search_bg"
            app:iconifiedByDefault="false"
            app:layout_constraintEnd_toStartOf="@id/expensesOverflowButton"
            app:layout_constraintTop_toTopOf="parent"
            app:queryHint="@string/search_expenses_hint" />

        <ImageButton
            android:id="@+id/expensesOverflowButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options_description"
            android:src="@android:drawable/ic_menu_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/mainNavButtonContainer"
            android:layout_width="400dp"
            android:layout_height="59dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="15dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/expensesHomeContainer"
            app:layout_constraintTop_toBottomOf="@id/expensesSearchView">

            <Button
                android:id="@+id/homeNavButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/menu_home"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/calendarNavButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/menu_calendar"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/notebookNavButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/menu_notebook"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/chartNavButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/menu_chart"
                android:textSize="11sp"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expensesHomeContainer"
            android:layout_width="410dp"
            android:layout_height="258dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/mainNavButtonContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addIncomeButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/hunter_green"
                    android:text="@string/add_income"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="30dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addExpenseButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/holo_orange_light"
                    android:text="@string/add_expense"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_remove_circle"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="394dp"
                android:layout_height="110dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/transferActionButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/holo_blue_dark"
                    android:text="@string/transfer"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/transactionActionButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/material_dynamic_neutral_variant40"
                    android:text="@string/transaction"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_agenda"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expensesCalendarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/mainNavButtonContainer">

            <CalendarView
                android:id="@+id/expensesCalendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.AppCompat.Dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expensesButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/expensesCalendarContainer">

            <Button
                android:id="@+id/allButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@color/material_dynamic_neutral_variant40"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/all_expenses"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/dailyButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/label_daily"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/weeklyButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_orange_light"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/label_weekly"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/monthlyButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_blue_dark"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/label_monthly"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/yearlyButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_purple"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text="@string/yearly"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/expensesChartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/expensesButtonContainer">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/chart_icon_description"
                android:src="@android:drawable/ic_menu_report_image"
                app:tint="@color/light_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/chart_placeholder_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/chart_placeholder_desc"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cashButtonsContainer"
            android:layout_width="417dp"
            android:layout_height="71dp"
            android:layout_marginTop="480dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/expensesButtonContainer"
            tools:layout_editor_absoluteX="-9dp">

            <Button
                android:id="@+id/cashInButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:text="@string/menu_cash_in"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="30dp" />

            <Button
                android:id="@+id/cashOutButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:backgroundTint="@color/chili_red"
                android:text="@string/menu_cash_out"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="30dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/expensesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expenses"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.511"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cashButtonsContainer"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/expensesNavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_expenses"
        app:menu="@menu/menu_expenses_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>