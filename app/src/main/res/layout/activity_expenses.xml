<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/expenses_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ExpensesActivity">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/expensesSearchView"
        android:layout_width="215dp"
        android:layout_height="30dp"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_search_bg"
        app:iconifiedByDefault="false"
        app:layout_constraintTop_toTopOf="parent"
        app:queryHint="@string/search_expenses_hint" />

    <LinearLayout
        android:id="@+id/expensesButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/expensesSearchView">

        <Button
            android:id="@+id/incomeButton"
            android:layout_width="125dp"
            android:layout_height="70dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/light_green"
            android:text="@string/income"
            android:textSize="11sp" />

        <Button
            android:id="@+id/expenseButton"
            android:layout_width="125dp"
            android:layout_height="70dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/holo_orange_light"
            android:text="@string/expense_type"
            android:textSize="11sp" />

        <Button
            android:id="@+id/transferButton"
            android:layout_width="125dp"
            android:layout_height="70dp"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:text="@string/transfer"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/expensesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/expenses"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expensesButtonContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>